# Copy to .env.local. Never commit real keys.
DATABASE_URL=postgres://naruvi:naruvi@127.0.0.1:5433/naruvi
# Encrypts API keys saved through Settings. Generate with: npm run settings:key
# Keep this private and stable; losing/changing it requires re-entering saved API keys.
SETTINGS_ENCRYPTION_KEY=
# Initial model defaults. Configure endpoint, model and API key in the Settings UI.
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# Default folder for Profile → Import (identity.md + pools/)
PROFILE_IMPORT_DIR=

# Where uploaded logos are stored (default: ./data/assets)
ASSETS_DIR=
