# Copy to .env.local. Never commit real keys.
DATABASE_URL=postgres://naruvi:naruvi@127.0.0.1:5433/naruvi
# Encrypts API keys saved through Settings. Generate with: npm run settings:key
# Keep this private and stable; losing/changing it requires re-entering saved API keys.
SETTINGS_ENCRYPTION_KEY=
# Initial model defaults. Configure endpoint, model and API key in the Settings UI.
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# Optional: folder used by `npm run profile:import` (identity.md + pools/), a developer tool.
PROFILE_IMPORT_DIR=

# Where uploaded logos are stored (default: ./data/assets)
ASSETS_DIR=

# Optional decision model (TypeSafe Jev) for fast, calibrated classification:
# requirement filtering, fit matching, job enrichment and claim verification.
# Text is still written by the language model above. Can also be set in Settings.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
