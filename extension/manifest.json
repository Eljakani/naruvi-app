{
  "manifest_version": 3,
  "name": "Save to Naruvi",
  "version": "1.0.0",
  "description": "Send the job posting you're looking at to your own Naruvi, including pages behind a login.",
  "action": { "default_title": "Save to Naruvi", "default_popup": "popup.html" },
  "options_ui": { "page": "options.html", "open_in_tab": false },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "browser_specific_settings": { "gecko": { "id": "save-to-naruvi@naruvi.local", "strict_min_version": "128.0" } }
}
