#!/usr/bin/env bash
# Manage an installed Naruvi. Lives in the installation directory; safe to symlink onto PATH.
set -euo pipefail
umask 077
self=$0
while [[ -L $self ]]; do link=$(readlink "$self"); [[ $link == /* ]] && self=$link || self=$(dirname "$self")/$link; done
root=$(cd "$(dirname "$self")" && pwd)
cd "$root"
[[ -f .env ]] || { echo "No Naruvi installation in $root" >&2; exit 1; }
setting() { sed -n "s/^$1=//p" .env | tail -n1; }
url=$(setting NARUVI_URL) mode=$(setting NARUVI_MODE)
bold= dim= green= red= reset=
if [[ -t 1 && ${TERM:-dumb} != dumb && -z ${NO_COLOR+x} ]]; then bold=$'\033[1m' dim=$'\033[90m' green=$'\033[38;5;108m' red=$'\033[38;5;167m' reset=$'\033[0m'; fi
say() { printf '  %s\n' "$*"; }
# Just added to the docker group (the installer does that): the group only applies to new
# logins, so use it through sg until then, the same way the installer does.
if command -v sg >/dev/null && ! id -nG | tr ' ' '\n' | grep -qx docker \
  && id -nG "${USER:-$(id -un)}" 2>/dev/null | tr ' ' '\n' | grep -qx docker; then
  docker() { sg docker -c "$(printf '%q ' docker "$@")"; }
fi
compose() { docker compose "$@"; }
link() { compose exec -T app node --import tsx scripts/setup-link.mts --raw; }
set_setting() { # key value: replace or add one line of .env, keeping it private
  local tmp; tmp=$(mktemp "$root/.env.XXXXXX")
  grep -v "^$1=" .env > "$tmp" || true
  printf '%s=%s\n' "$1" "$2" >> "$tmp"
  chmod 600 "$tmp"; mv "$tmp" .env
}

# Published images are built by this repository's release workflow and signed
# keylessly with its identity. One is used only if that signature was made for
# the release tag, at the commit the signed tag points to.
image_repo=ghcr.io/eljakani/naruvi-app
image_signer=https://github.com/Eljakani/naruvi-app/.github/workflows/release.yml
cosign=ghcr.io/sigstore/cosign/cosign:v2.5.3@sha256:f1946d0f30fc8e3777b02f2201e02efdba9fe38f4918162f937052fac98e083f

# Built from ./source (build.yaml, or a compose.yaml from before published images).
building() { [[ $(setting COMPOSE_FILE) == *build.yaml* ]] || grep -q '^ *build:' compose.yaml; }

# version commit -> prints image@digest. Exit 2: no published image of this version for this machine;
# 3: it could not be downloaded (Docker's reason on stderr); 1: not verified.
release_image() {
  local digest out
  if ! out=$(docker pull --quiet "$image_repo:$1" 2>&1); then
    grep -qiE 'manifest unknown|not found|no matching manifest' <<< "$out" && return 2
    printf '%s\n' "$out" | grep -v '^[[:space:]]*$' | tail -n1 >&2
    return 3
  fi
  digest=$(docker image inspect --format '{{range .RepoDigests}}{{println .}}{{end}}' "$image_repo:$1" 2>/dev/null | grep "^$image_repo@sha256:" | head -n1)
  [[ -n $digest ]] || return 1
  docker run --rm "$cosign" verify \
    --certificate-identity "$image_signer@refs/tags/v$1" \
    --certificate-oidc-issuer https://token.actions.githubusercontent.com \
    --certificate-github-workflow-sha "$2" \
    "$digest" >/dev/null 2>&1 || return 1
  printf '%s\n' "$digest"
}

backup() {
  local stamp dir
  stamp=$(date +%Y%m%d-%H%M%S) dir=$root/backups/$stamp
  mkdir -p "$dir"; chmod 700 "$root/backups" "$dir"; backup_dir=$dir
  say "Backing up to $dir"
  compose exec -T db pg_dump -U naruvi -d naruvi --clean --if-exists | gzip > "$dir/database.sql.gz"
  compose exec -T app tar -C /app/data -cf - assets | gzip > "$dir/assets.tar.gz"
  cp .env "$dir/env"
  chmod 600 "$dir"/*
  say "${green}Done.${reset} Keep ${bold}env${reset} safe: it holds the key that decrypts your saved credentials."
}

installed_version() { sed -n 's/^  "version": "\(.*\)",$/\1/p' source/package.json; }
newest() { printf '%s\n' "$@" | sort -V | tail -n1; }

# umask 077 makes checked-out files owner-only; the image runs as `node` and must read them.
readable() { chmod -R go+rX source; }

restore_db() { # backup dir: recreate the database so tables added by a migration go too
  compose exec -T db psql -q -U naruvi -d postgres -v ON_ERROR_STOP=1 \
    -c 'DROP DATABASE IF EXISTS naruvi WITH (FORCE)' -c 'CREATE DATABASE naruvi OWNER naruvi'
  gunzip -c "$1/database.sql.gz" | compose exec -T db psql -q -U naruvi -d naruvi -v ON_ERROR_STOP=1 >/dev/null
}

healthy() { # the app answers from inside its container, whatever the mode
  local attempt
  for attempt in $(seq 1 40); do
    compose exec -T app node -e "fetch('http://127.0.0.1:3000/login').then(r=>process.exit(r.status<500?0:1),()=>process.exit(1))" 2>/dev/null && return 0
    sleep 3
  done
  return 1
}

# Release tags are signed vX.Y.Z tags, checked against ./trusted-signers (copied once at install).
update() {
  local check=false unsigned=false assume=false ref= current target previous dir answer images image previous_image= new_image status
  while [[ $# -gt 0 ]]; do
    case $1 in
      --check) check=true;;
      --allow-unsigned) unsigned=true;;
      --yes|-y) assume=true;;
      --ref) ref=${2:?--ref needs a tag or branch}; shift;;
      v*) ref=$1;;
      *) say "Unknown option: $1. Usage: naruvi update [--check] [vX.Y.Z | --ref REF --allow-unsigned] [--yes]"; exit 2;;
    esac
    shift
  done
  [[ -d source/.git ]] || { say "This installation was made from a local copy. Replace $root/source, then run: naruvi rebuild"; exit 1; }
  [[ -f trusted-signers ]] || cp source/deploy/trusted-signers trusted-signers 2>/dev/null || : > trusted-signers
  chmod 600 trusted-signers
  current=$(installed_version)
  if [[ -z $ref ]]; then
    ref=$(git -C source ls-remote --tags --refs origin 'v*' | sed -n 's|.*refs/tags/\(v[0-9]*\.[0-9]*\.[0-9]*\)$|\1|p' | sort -V | tail -n1)
    [[ -n $ref ]] || { say "No releases found at $(git -C source remote get-url origin)."; exit 1; }
  fi
  if [[ $ref == v* && ( ${ref#v} == "$current" || $(newest "${ref#v}" "$current") == "$current" ) ]]; then
    say "${green}Up to date.${reset} Naruvi $current (latest release: ${ref#v})"; return 0
  fi
  if [[ $check == true ]]; then say "${bold}Update available:${reset} $current → ${ref#v}. Run: naruvi update"; return 0; fi

  say "Fetching $ref"
  git -C source fetch --quiet --depth 1 --force origin "+refs/tags/$ref:refs/tags/$ref" 2>/dev/null \
    || git -C source fetch --quiet --depth 1 origin "$ref" || { say "${red}Could not fetch $ref.${reset}"; exit 1; }
  target=$(git -C source rev-parse --verify --quiet "refs/tags/$ref^{commit}" || git -C source rev-parse FETCH_HEAD)
  if git -C source -c gpg.ssh.allowedSignersFile="$root/trusted-signers" verify-tag "$ref" >/dev/null 2>&1; then
    say "${green}Signature verified${reset} for $ref"
  elif [[ $unsigned == true ]]; then
    say "${red}Not verified:${reset} $ref has no signature from a key in $root/trusted-signers. Continuing because of --allow-unsigned."
  else
    say "${red}Refusing $ref:${reset} it is not signed by a key in $root/trusted-signers."
    say "Only if you trust where it came from: naruvi update --ref $ref --allow-unsigned"; exit 1
  fi
  if ! building && [[ ! $ref =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    say "${red}$ref has no published image.${reset} This installation runs signed release images; only release tags (vX.Y.Z) can be installed."
    exit 1
  fi
  say "Naruvi $current → $(git -C source show "$target:package.json" | sed -n 's/^  "version": "\(.*\)",$/\1/p') ($ref)"
  git -C source show "$target:CHANGELOG.md" 2>/dev/null | awk -v cur="$current" '/^## /{ if (index($0, cur)) exit; on=1 } on' | head -n 30 | sed 's/^/    /'
  if [[ $assume == false ]]; then
    printf '  A backup is made first. Continue? [Y/n] '; read -r answer
    [[ -z $answer || $answer == y || $answer == Y ]] || exit 0
  fi

  previous=$(git -C source rev-parse HEAD)
  backup; dir=$backup_dir
  images=$(compose config --images | grep -v @ | sort -u)
  for image in $images; do docker image tag "$image" "$image-previous" 2>/dev/null || true; done
  git -C source checkout --quiet --detach "$target"; readable
  if building; then
    say "Building (Naruvi keeps running meanwhile)"
    if ! compose build --quiet; then
      git -C source checkout --quiet --detach "$previous"; readable
      say "${red}Build failed.${reset} Nothing changed; still on $current."; exit 1
    fi
  else
    say "Downloading and verifying the signed image (Naruvi keeps running meanwhile)"
    status=0; new_image=$(release_image "${ref#v}" "$target") || status=$?
    if [[ $status != 0 ]]; then
      git -C source checkout --quiet --detach "$previous"; readable
      if [[ $status == 2 ]]; then say "${red}No published image of $ref for this machine yet.${reset} Nothing changed; still on $current. Try again in a few minutes."
      elif [[ $status == 3 ]]; then say "${red}Couldn't download the $ref image${reset} (Docker's message is above). Nothing changed; still on $current."
      else say "${red}The $ref image did not pass signature verification.${reset} It was not used. Nothing changed; still on $current."; fi
      exit 1
    fi
    previous_image=$(setting NARUVI_IMAGE)
    set_setting NARUVI_IMAGE "$new_image"
  fi
  say "Migrating and restarting"
  if compose up -d >/dev/null 2>&1 && healthy; then
    cmp -s source/deploy/naruvi "$root/naruvi" || { cp source/deploy/naruvi "$root/naruvi.new" && chmod 700 "$root/naruvi.new" && mv "$root/naruvi.new" "$root/naruvi"; }
    for file in compose.yaml "$mode.yaml"; do
      cmp -s "source/deploy/$file" "$file" || say "${dim}Note: source/deploy/$file changed. Review it before copying over $file.${reset}"
    done
    ! grep -q '^ *build:' compose.yaml || say "Tip: ${bold}naruvi use-images${reset} switches to the published, signed image: updates in a minute instead of a full build."
    say "${green}Updated to $(installed_version).${reset} $url  ${dim}(backup: $dir)${reset}"; return 0
  fi

  say "${red}The new version did not start.${reset} Rolling back to $current."
  compose logs --no-color --tail=30 migrate app 2>/dev/null | sed 's/^/    /'
  compose stop app worker >/dev/null 2>&1 || true
  restore_db "$dir"
  git -C source checkout --quiet --detach "$previous"; readable
  [[ -z $previous_image ]] || set_setting NARUVI_IMAGE "$previous_image"
  for image in $images; do docker image tag "$image-previous" "$image" 2>/dev/null || true; done
  compose up -d >/dev/null 2>&1 && healthy \
    && say "${green}Rolled back.${reset} Naruvi $current is running with the database from before the update." \
    || say "${red}Rollback did not come up either.${reset} Your backup is in $dir. Run: naruvi logs app"
  exit 1
}

# Move an installation that builds from ./source to the published, signed image of the same version.
use_images() {
  local version commit image status=0 compose_files
  if ! building; then say "${green}Already on the published image:${reset} $(setting NARUVI_IMAGE)"; return 0; fi
  [[ -d source/.git ]] || { say "This installation was made from a local copy; it keeps building from ./source."; exit 1; }
  version=$(installed_version); commit=$(git -C source rev-parse HEAD)
  git -C source tag --points-at HEAD | grep -qx "v$version" \
    || { say "The installed source is not the v$version release. Update to a release first: naruvi update"; exit 1; }
  say "Downloading and verifying the Naruvi $version image"
  image=$(release_image "$version" "$commit") || status=$?
  case $status in
    0) ;;
    2) say "${red}No published image of $version for this machine.${reset} Releases from 0.3.0 on have one: run naruvi update first."; exit 1;;
    3) say "${red}Couldn't download the $version image${reset} (Docker's message is above). Nothing changed."; exit 1;;
    *) say "${red}The $version image did not pass signature verification.${reset} Nothing changed."; exit 1;;
  esac
  cp compose.yaml compose.yaml.before-images; cp .env .env.before-images; chmod 600 .env.before-images
  cp source/deploy/compose.yaml compose.yaml
  cmp -s source/deploy/build.yaml build.yaml 2>/dev/null || cp source/deploy/build.yaml build.yaml
  compose_files=$(setting COMPOSE_FILE); compose_files=${compose_files//:build.yaml/}
  set_setting COMPOSE_FILE "$compose_files"
  set_setting NARUVI_IMAGE "$image"
  say "Restarting on the published image"
  if compose up -d >/dev/null 2>&1 && healthy; then
    say "${green}Done.${reset} Naruvi $version now runs $image. Updates download it instead of building."
    say "${dim}Your previous compose.yaml and .env are kept as compose.yaml.before-images and .env.before-images.${reset}"
    return 0
  fi
  say "${red}It did not start on the published image.${reset} Putting the previous setup back."
  mv compose.yaml.before-images compose.yaml; mv .env.before-images .env
  compose up -d >/dev/null 2>&1 && healthy && say "Back on the source build. See: naruvi logs app" || say "${red}Still not up.${reset} Run: naruvi logs app"
  exit 1
}

case ${1:-help} in
  status)
    printf '\n  %sNaruvi%s  %s  %s(%s)%s\n\n' "$bold" "$reset" "$url" "$dim" "$mode" "$reset"
    compose ps --format 'table {{.Service}}\t{{.State}}\t{{.Status}}'
    echo;;
  open)
    if command -v xdg-open >/dev/null; then xdg-open "$url"; elif command -v open >/dev/null; then open "$url"; else say "$url"; fi;;
  logs) shift; compose logs -f --tail=200 "$@";;
  start) compose up -d; say "Running at $url";;
  stop) compose stop;;
  restart) compose restart app worker;;
  setup-link)
    value=$(link) || exit $?
    printf '\n  Create your owner account (one-time, expires in 1 hour):\n\n  %s%s%s\n\n  %sKeep it private. Earlier setup links no longer work.%s\n\n' "$bold" "$value" "$reset" "$dim" "$reset";;
  reset-password) compose exec app npm run --silent auth:reset-password;;
  backup) backup;;
  update) shift; update "$@";;
  use-images) use_images;;
  release-image) release_image "${2:?version}" "${3:?commit}";; # used by the installer
  restore)
    [[ -n ${2:-} && -f $2/database.sql.gz ]] || { say "Usage: naruvi restore backups/<timestamp>"; exit 2; }
    printf '  Replace the current database%s with %s? Type %srestore%s: ' "$([[ -f $2/assets.tar.gz ]] && echo ' and files')" "$2" "$bold" "$reset"; read -r answer
    [[ $answer == restore ]] || { say 'Cancelled.'; exit 0; }
    compose stop app worker
    restore_db "$2"
    [[ ! -f $2/assets.tar.gz ]] || gunzip -c "$2/assets.tar.gz" | compose run --rm -T --no-deps --entrypoint tar app -C /app/data -xf -
    compose up -d
    say "${green}Restored.${reset} $url";;
  version)
    printf '  Naruvi %s%s%s %s\n' "$bold" "$(installed_version)" "$reset" "$dim$(git -C source rev-parse --short HEAD 2>/dev/null)$reset"
    update --check;;
  rebuild)
    building || { say "This installation runs the published image; there is nothing to build. Restarting."; compose up -d; exit 0; }
    compose up -d --build;;
  uninstall)
    say "This stops and removes Naruvi's containers. Your data volumes and $root are kept."
    say "To also delete all data, run: docker compose down -v   (from $root, after a backup)"
    printf '  Type %suninstall%s to continue: ' "$bold" "$reset"; read -r answer
    [[ $answer == uninstall ]] || { say 'Cancelled.'; exit 0; }
    compose down
    [[ ! -L $HOME/.local/bin/naruvi ]] || rm "$HOME/.local/bin/naruvi"
    say 'Removed containers.';;
  compose) shift; compose "$@";;
  help|--help|-h)
    cat <<EOF

  ${bold}naruvi${reset} · manage the Naruvi installation in $root

  ${bold}status${reset}            what is running, and where
  ${bold}open${reset}              open Naruvi in your browser
  ${bold}logs${reset} [service]    follow logs (app, worker, db, gateway)
  ${bold}start | stop | restart${reset}
  ${bold}setup-link${reset}        new private link to create the owner account
  ${bold}reset-password${reset}    set a new owner password (signs out every session)
  ${bold}backup${reset}            database, uploaded files and keys into ./backups
  ${bold}version${reset}           installed version, and whether a newer release exists
  ${bold}update${reset} [vX.Y.Z]   verify the signed release and image, back up, migrate; rolls back on failure
                    --check only looks · --ref REF --allow-unsigned for a branch
  ${bold}restore${reset} DIR       put a backup from ./backups back (database and files)
  ${bold}use-images${reset}        switch a source build to the published, signed image
  ${bold}rebuild${reset}           rebuild from ./source and restart (source builds)
  ${bold}compose${reset} ...       run any docker compose command here
  ${bold}uninstall${reset}         remove containers, keep your data

EOF
    ;;
  *) printf '  %sUnknown command%s: %s. Try: naruvi help\n' "$red" "$reset" "$1" >&2; exit 2;;
esac
