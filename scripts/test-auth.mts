import assert from "node:assert/strict"
import { randomBytes } from "node:crypto"
import { config } from "dotenv"
import postgres from "postgres"
config({ path: ".env.local", quiet: true })
const url = process.env.DATABASE_URL!
const control = postgres(url, { max: 1, onnotice: () => {} })
const schema = `auth_test_${randomBytes(8).toString("hex")}`
const scoped = new URL(url)
scoped.searchParams.set("search_path", schema)
process.env.DATABASE_URL = scoped.href
try {
  await control.unsafe(`CREATE SCHEMA ${schema}`)
  const auth = await import("../src/server/auth/store")
  const crypto = await import("../src/server/auth/crypto")
  await auth.initializeAuth()
  assert.equal(await auth.hasOwner(), false)
  const secret = crypto.token()
  await control.unsafe(`INSERT INTO ${schema}.naruvi_bootstrap VALUES (1,$1,now()+interval '1 hour')`, [crypto.digest(secret)])
  assert.equal(await auth.validSetup("wrong"), false)
  assert.equal(await auth.validSetup(secret), true)
  const password = await crypto.hashPassword("a-long-test-passphrase")
  assert.equal(await crypto.verifyPassword("a-long-test-passphrase", password), true)
  assert.equal(await crypto.verifyPassword("wrong", password), false)
  const created = await Promise.all([auth.createOwner(secret,"owner",password),auth.createOwner(secret,"owner",password)])
  assert.equal(created.filter(Boolean).length, 1)
  assert.equal(await auth.validSetup(secret), false)
  const session = await auth.newSession()
  assert.equal(await auth.validSession(session), true)
  const rows = await control.unsafe(`SELECT hash FROM ${schema}.naruvi_sessions`)
  assert.notEqual(rows[0].hash, session)
  await control.unsafe(`UPDATE ${schema}.naruvi_sessions SET last_seen=now()-interval '31 minutes' WHERE hash=$1`, [crypto.digest(session)])
  assert.equal(await auth.validSession(session), false)
  await auth.revokeSession(session)
  assert.equal(await auth.validSession(session), false)
  const attempts = await Promise.all(Array.from({ length: 12 }, () => auth.allowedAttempt()))
  assert.equal(attempts.filter(Boolean).length, 10)
  await control.unsafe(`DELETE FROM ${schema}.naruvi_auth_limit`)
  const { NextRequest } = await import("next/server")
  const routes = await import("../src/app/auth/[action]/route")
  const { proxy } = await import("../src/proxy")
  process.env.NARUVI_URL = "https://careers.example.com"
  const context = { params: Promise.resolve({ action: "login" }) }
  const loginPage = await proxy(new NextRequest("https://careers.example.com/login"))
  assert.equal(loginPage.headers.get("referrer-policy"), "same-origin")
  const nullOrigin = await routes.POST(new NextRequest("https://careers.example.com/auth/register", { method: "POST", headers: { origin: "null" } }), { params: Promise.resolve({ action: "register" }) })
  assert.equal(nullOrigin.status, 403)
  const blocked = await routes.POST(new NextRequest("https://careers.example.com/auth/login", { method: "POST", headers: { origin: "https://evil.example" } }), context)
  assert.equal(blocked.status, 403)
  const inlineFailure = await routes.POST(new NextRequest("https://careers.example.com/auth/login", { method: "POST", headers: { origin: process.env.NARUVI_URL, accept: "application/json", "content-type": "application/x-www-form-urlencoded" }, body: new URLSearchParams({ username: "owner", password: "incorrect-long-password" }) }), context)
  assert.equal(inlineFailure.status, 401)
  assert.deepEqual(await inlineFailure.json(), { error: "The username or password is incorrect." })
  const signedIn = await routes.POST(new NextRequest("https://careers.example.com/auth/login", { method: "POST", headers: { origin: process.env.NARUVI_URL, "content-type": "application/x-www-form-urlencoded" }, body: new URLSearchParams({ username: "owner", password: "a-long-test-passphrase" }) }), context)
  assert.equal(signedIn.status, 303)
  const cookie = (signedIn as import("next/server").NextResponse).cookies.get("__Host-naruvi_session")!
  assert.ok(cookie.httpOnly && cookie.secure && cookie.sameSite === "lax")
  assert.equal((await proxy(new NextRequest("https://careers.example.com/api/export"))).status, 401)
  assert.equal((await proxy(new NextRequest("https://careers.example.com/"))).status, 307)
  const headers = { cookie: `__Host-naruvi_session=${cookie.value}` }
  assert.equal((await proxy(new NextRequest("https://careers.example.com/", { headers }))).status, 200)
  assert.equal((await proxy(new NextRequest("https://careers.example.com/", { method: "POST", headers: { ...headers, origin: "https://evil.example" } }))).status, 403)
  const signedInLogin = await proxy(new NextRequest("https://careers.example.com/login?next=%2Fapplications", { headers }))
  assert.equal(signedInLogin.status, 307)
  assert.equal(signedInLogin.headers.get("location"), "https://careers.example.com/applications")
  const maliciousReturn = await proxy(new NextRequest("https://careers.example.com/login?next=https://evil.example", { headers }))
  assert.equal(maliciousReturn.headers.get("location"), "https://careers.example.com/")
  const signedInSetup = await routes.GET(new NextRequest("https://careers.example.com/auth/setup?token=old", { headers }), { params: Promise.resolve({ action: "setup" }) })
  assert.equal(signedInSetup.headers.get("location"), "https://careers.example.com/")
  const beforePing = await control.unsafe(`UPDATE ${schema}.naruvi_sessions SET last_seen=now()-interval '2 minutes' WHERE hash=$1 RETURNING last_seen`, [crypto.digest(cookie.value)])
  const ping = await routes.GET(new NextRequest("https://careers.example.com/auth/session", { headers }), { params: Promise.resolve({ action: "session" }) })
  assert.equal(ping.status, 204)
  const afterPing = await control.unsafe(`SELECT last_seen FROM ${schema}.naruvi_sessions WHERE hash=$1`, [crypto.digest(cookie.value)])
  assert.equal(String(beforePing[0].last_seen), String(afterPing[0].last_seen))
  await routes.POST(new NextRequest("https://careers.example.com/auth/logout", { method: "POST", headers: { ...headers, origin: process.env.NARUVI_URL } }), { params: Promise.resolve({ action: "logout" }) })
  assert.equal(await auth.validSession(cookie.value), false)
  const signedOutPing = await routes.GET(new NextRequest("https://careers.example.com/auth/session", { headers }), { params: Promise.resolve({ action: "session" }) })
  assert.equal(signedOutPing.status, 401)
  const expiredPage = await proxy(new NextRequest("https://careers.example.com/applications?view=board", { headers }))
  const expiredTarget = new URL(expiredPage.headers.get("location")!)
  assert.equal(expiredTarget.searchParams.get("next"), "/applications?view=board")
  assert.equal(expiredTarget.searchParams.get("notice"), "session-expired")
  assert.ok(expiredPage.headers.get("set-cookie")?.includes("Max-Age=0"))
  const policy = await import("../src/server/auth/policy")
  const spoofed = new NextRequest("https://careers.example.com/auth/login", { headers: { "x-forwarded-for": "1.2.3.4", "x-naruvi-client-ip": "1.2.3.4" } })
  delete process.env.NARUVI_TRUST_PROXY
  assert.equal(policy.clientBucket(spoofed), "untrusted")
  process.env.NARUVI_TRUST_PROXY = "on"
  assert.equal(policy.clientBucket(spoofed), "1.2.3.4")
  const parallel = await Promise.all(Array.from({ length: 8 }, () => auth.rateLimit("fixture-client", 5, 60)))
  assert.equal(parallel.filter(r => r.allowed).length, 5)
  assert.ok(parallel[7].retry > 0)
  await control.unsafe(`UPDATE ${schema}.naruvi_auth_buckets SET expires=now()-interval '1 second' WHERE key=$1`, [crypto.digest("fixture-client")])
  assert.equal((await auth.rateLimit("fixture-client", 5, 60)).allowed, true)
  await control.unsafe(`DELETE FROM ${schema}.naruvi_auth_buckets`)
  await control.unsafe(`DELETE FROM ${schema}.naruvi_auth_limit`)
  for (let i = 0; i < 5; i++) await auth.rateLimit("credentials:untrusted", 5, 60)
  const throttled = await routes.POST(new NextRequest("https://careers.example.com/auth/login", { method: "POST", headers: { origin: process.env.NARUVI_URL, accept: "application/json" } }), context)
  assert.equal(throttled.status, 429)
  assert.ok(Number(throttled.headers.get("retry-after")) > 0)
  assert.equal(policy.sameOrigin(new NextRequest("https://careers.example.com/auth/login", { headers: { origin: process.env.NARUVI_URL, "sec-fetch-site": "cross-site" } })), false)
  for (let i = 0; i < 12; i++) await auth.newSession()
  const count = await control.unsafe(`SELECT count(*)::int AS n FROM ${schema}.naruvi_sessions`)
  assert.equal(count[0].n, 10)
  await control.unsafe(`DELETE FROM ${schema}.naruvi_auth_buckets`)
  await control.unsafe(`DELETE FROM ${schema}.naruvi_auth_limit`)
  const oversized = await routes.POST(new NextRequest("https://careers.example.com/auth/login", { method: "POST", headers: { origin: process.env.NARUVI_URL, "content-type": "application/x-www-form-urlencoded" }, body: "a".repeat(4097) }), context)
  assert.equal(oversized.status, 413)
  const duplicate = await routes.POST(new NextRequest("https://careers.example.com/auth/login", { method: "POST", headers: { origin: process.env.NARUVI_URL, accept: "application/json", "content-type": "application/x-www-form-urlencoded" }, body: "username=owner&username=other&password=long-enough-password" }), context)
  assert.equal(duplicate.status, 400)
  for (let i = 0; i < 20; i++) await auth.rateLimit("setup:untrusted", 20, 60)
  const setupLimited = await routes.GET(new NextRequest("https://careers.example.com/auth/setup?token=bad"), { params: Promise.resolve({ action: "setup" }) })
  assert.equal(setupLimited.status, 303)
  assert.ok(setupLimited.headers.get("location")?.includes("already-configured"))
  const hashes = await Promise.allSettled([crypto.hashPassword("first-long-password"), crypto.hashPassword("second-long-password"), crypto.hashPassword("third-long-password")])
  assert.equal(hashes.filter(r => r.status === "fulfilled").length, 2)
  assert.equal(hashes.filter(r => r.status === "rejected").length, 1)
  const beforeReset = await auth.newSession(password)
  const replacement = await crypto.hashPassword("replacement-test-passphrase")
  await auth.resetOwnerPassword(replacement)
  assert.equal(await auth.validSession(beforeReset), false)
  const resetAccount = await auth.owner()
  assert.equal(resetAccount?.username, "owner")
  assert.equal(await crypto.verifyPassword("a-long-test-passphrase", resetAccount!.password), false)
  assert.equal(await crypto.verifyPassword("replacement-test-passphrase", resetAccount!.password), true)
  await assert.rejects(() => auth.newSession(password), /Credentials changed/)
  assert.equal(await auth.validSession(await auth.newSession(replacement)), true)
  await control.unsafe(`DELETE FROM ${schema}.naruvi_owner`)
  await control.unsafe(`DELETE FROM ${schema}.naruvi_auth_buckets`)
  await control.unsafe(`INSERT INTO ${schema}.naruvi_bootstrap VALUES (1,$1,now()-interval '1 second')`, [crypto.digest(secret)])
  const expiredSetup = await routes.GET(new NextRequest(`https://careers.example.com/auth/setup?token=${secret}`), { params: Promise.resolve({ action: "setup" }) })
  assert.ok(expiredSetup.headers.get("location")?.includes("setup-expired"))
  assert.ok(expiredSetup.headers.get("set-cookie")?.includes("Max-Age=0"))
  console.log("Auth integration passed: password hashing, setup race, token consumption, sessions, revocation and rate limits.")
} catch (error) {
  console.error(error)
  process.exitCode = 1
} finally {
  await control.unsafe(`DROP SCHEMA IF EXISTS ${schema} CASCADE`)
  await control.end()
  process.exit(process.exitCode || 0)
}
