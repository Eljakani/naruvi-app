{
  "name": "naruvi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:up": "docker compose up -d db",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "settings:key": "node --import tsx scripts/init-settings-key.mts",
    "worker": "tsx watch worker/index.mts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\" \"evals/**/*.test.ts\"",
    "profile:import": "tsx --conditions=react-server scripts/import-profile.mts",
    "jobs:smoke": "tsx --conditions=react-server scripts/smoke-jobs.mts",
    "jobs:capture": "tsx scripts/capture-job-fixture.mts",
    "browser:install": "playwright install chromium",
    "test:browser": "node --conditions=react-server --import tsx scripts/test-job-browser.mts",
    "test:settings": "node --conditions=react-server --import tsx scripts/test-model-settings.mts",
    "evals": "tsx --test \"evals/**/*.test.ts\"",
    "ai:try": "tsx --conditions=react-server scripts/try-ai-steps.mts",
    "ai:try:analysis": "tsx --conditions=react-server scripts/try-ai-analysis.mts",
    "jobs:enrich": "tsx --conditions=react-server scripts/enrich-jobs.mts"
  },
  "dependencies": {
