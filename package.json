    "@fontsource/noto-sans-hebrew": "^5.3.0",
    "@fontsource/noto-sans-thai": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.1",
    "@react-pdf/renderer": "^4.9.0",
    "ai": "^7.0.163",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "drizzle-orm": "^0.45.4",
