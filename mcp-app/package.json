{
  "name": "naruvi-mcp-app",
  "version": "0.1.0",
  "private": true,
  "description": "Naruvi as an MCP App: visual views of applications, fit analysis and CVs for Claude, ChatGPT and other MCP Apps hosts. Built with Skybridge.",
  "type": "module",
  "scripts": {
    "dev": "SKYBRIDGE_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 skybridge dev --port 3200",
    "build": "SKYBRIDGE_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 skybridge build",
    "start": "SKYBRIDGE_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 skybridge start --port 3200",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "skybridge": "^2.1.2",
    "vite": "^8.1.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@skybridge/devtools": "^2.1.2",
    "@skybridge/vite-plugin": "^2.1.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
