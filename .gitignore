# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
__pycache__/
*.py[cod]

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.claude/

# local asset store
/data

# graphify code index
graphify-out/

# ONNX runtime for local Whisper, copied from node_modules at dev/build time
/public/ort/

# local browser diagnostics and live UI sessions
/.tmp-*.mjs
/.impeccable/live/

# Local launch-video workspace (not part of the project)
marketing/
